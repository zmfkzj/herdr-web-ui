diff --git a/src/lib/pi-visual/api.ts b/src/lib/pi-visual/api.ts
new file mode 100644
index 0000000..13beba8
--- /dev/null
+++ b/src/lib/pi-visual/api.ts
@@ -0,0 +1,42 @@
+import { machinePath, paneStorageId } from "../../../shared/machines.ts";
+import type { ImageAnnotation, ImageReviewDocument, PiVisualWorkers, ReviewSource } from "../../../shared/pi-visual.ts";
+import { composerDrafts } from "../composerDraft.ts";
+import { appendQuote } from "../terminalQuote.ts";
+import { MAX_COMPOSER_CHARS } from "../compose.ts";
+
+export function visualUrl(machine: string,pane: string,route: string,query: Record<string,string>={}): string {
+  return machinePath(machine,`pane/pi-visual/${route}?${new URLSearchParams({pane_id:pane,...query})}`);
+}
+export async function visualRequest<T>(url: string,method="GET",body?: unknown,signal?: AbortSignal): Promise<T> {
+  const response=await fetch(url,{method,credentials:"same-origin",cache:"no-store",headers:{"content-type":"application/json","x-herdr-machine":"1"},...(body===undefined?{}:{body:JSON.stringify(body)}),signal});
+  const result=await response.json();
+  if(!response.ok) throw new Error(typeof result?.error?.message==="string" ? result.error.message : "Pi visual request failed");
+  return result as T;
+}
+export function sourceFromImage(src: string,machine: string,pane: string,origin: string): ReviewSource {
+  const url=new URL(src,origin);
+  if(url.origin!==origin || url.searchParams.get("pane_id")!==pane) throw new Error("Image does not belong to this pane");
+  if(url.pathname===machinePath(machine,"pane/conversation/image") && url.searchParams.get("ref")) return {kind:"conversation",ref:url.searchParams.get("ref")!};
+  if(url.pathname===machinePath(machine,"fs/file") && url.searchParams.get("path")) return {kind:"file",path:url.searchParams.get("path")!};
+  throw new Error("Unsupported image source");
+}
+export async function checkSession(machine: string,pane: string,session: string): Promise<void> {
+  const result=await visualRequest<PiVisualWorkers>(visualUrl(machine,pane,"workers",{session}));
+  if(result.session!==session) throw new Error("Pi session changed; reopen visual tools");
+}
+export function addDraft(machine: string,pane: string,text: string): void {
+  const key=`herdr-web-ui:composer-draft:${paneStorageId(machine,pane)}`;
+  composerDrafts.refresh(key); const draft=composerDrafts.read(key);
+  if(draft.sending) throw new Error("A message is being sent. Try again afterwards.");
+  const next=appendQuote(draft.text,text,MAX_COMPOSER_CHARS);
+  if(next===null) throw new Error("Too long for the message draft");
+  composerDrafts.set(key,next);
+}
+/** Explicitly requested feedback, never automatically submitted to the agent. */
+export function feedbackText(doc: ImageReviewDocument,imagePath: string,notes: ImageAnnotation[],heading: string): string {
+  return `${heading}\n${JSON.stringify(imagePath)}\nImage SHA-256: ${doc.id}\n${notes.filter(n=>!n.resolved).map(n=> {
+    const ordinal=notes.findIndex(other=>other.id===n.id)+1;
+    const region=[n.x,n.y,n.width,n.height].map(v=>v.toFixed(4)).join(", ");
+    return `${ordinal}. [x,y,w,h normalized: ${region}] ${n.text}`;
+  }).join("\n")}`;
+}
diff --git a/src/lib/pi-visual/guacamole.d.ts b/src/lib/pi-visual/guacamole.d.ts
new file mode 100644
index 0000000..d38458e
--- /dev/null
+++ b/src/lib/pi-visual/guacamole.d.ts
@@ -0,0 +1,12 @@
+/** Narrow public API of the pinned Apache Guacamole client. */
+declare module "guacamole-common-js" {
+  interface Status { code:number; message:string }
+  interface MouseState { x:number;y:number;left:boolean;middle:boolean;right:boolean;up:boolean;down:boolean }
+  class WebSocketTunnel { constructor(url:string); onerror:((status:Status)=>void)|null; disconnect():void }
+  class Display { getElement():HTMLElement; getWidth():number; getHeight():number; scale(value:number):void; onresize:((width:number,height:number)=>void)|null }
+  class Client { constructor(tunnel:WebSocketTunnel); connect(data?:string):void; disconnect():void; getDisplay():Display; onerror:((status:Status)=>void)|null; onstatechange:((state:number)=>void)|null; sendKeyEvent(pressed:number,keysym:number):void; sendMouseState(state:MouseState,applyDisplayScale?:boolean):void }
+  class Mouse { constructor(element:HTMLElement); onmousedown:((state:MouseState)=>void)|null; onmouseup:((state:MouseState)=>void)|null; onmousemove:((state:MouseState)=>void)|null }
+  class Keyboard { constructor(element:HTMLElement); onkeydown:((keysym:number)=>boolean|void)|null; onkeyup:((keysym:number)=>void)|null; reset():void }
+  const Guacamole: { WebSocketTunnel:typeof WebSocketTunnel; Client:typeof Client; Mouse:typeof Mouse; Keyboard:typeof Keyboard };
+  export default Guacamole;
+}
diff --git a/src/lib/pi-visual/visual.test.ts b/src/lib/pi-visual/visual.test.ts
new file mode 100644
index 0000000..e4edbe3
--- /dev/null
+++ b/src/lib/pi-visual/visual.test.ts
@@ -0,0 +1,15 @@
+import { expect, it } from "bun:test";
+import { feedbackText, sourceFromImage, visualUrl } from "./api.ts";
+import type { ImageReviewDocument } from "../../../shared/pi-visual.ts";
+it("does not interpret an arbitrary URL as a server image",()=>{
+  expect(sourceFromImage("/api/pane/conversation/image?pane_id=p1&ref=img","local","p1","https://local")).toEqual({kind:"conversation",ref:"img"});
+  expect(sourceFromImage("/api/fs/file?pane_id=p1&path=%2Fimage.png","local","p1","https://local")).toEqual({kind:"file",path:"/image.png"});
+  expect(()=>sourceFromImage("https://evil/api/fs/file?pane_id=p1&path=a","local","p1","https://local")).toThrow();
+  expect(()=>sourceFromImage("/api/fs/file?pane_id=p2&path=a","local","p1","https://local")).toThrow();
+  expect(visualUrl("remote a","p1","workers")).toContain("/api/machines/remote%20a/");
+});
+it("feedback keeps image version, annotation numbers and normalized regions",()=>{
+  const notes=[{id:"a",x:0,y:0,width:0.1,height:0.2,text:"done",resolved:true},{id:"b",x:0.5,y:0.5,width:0,height:0,text:"fix here",resolved:false}];
+  const doc:ImageReviewDocument={id:"a".repeat(64),session:"s",revision:1,name:"image.png",mime:"image/png",updated:0,annotations:notes};
+  const feedback=feedbackText(doc,"/folder with spaces/review.png",notes,"Review");expect(feedback).toContain('"/folder with spaces/review.png"');expect(feedback).toContain("2. [x,y,w,h normalized: 0.5000");expect(feedback).not.toContain("done");expect(feedback).toContain(doc.id);
+});
