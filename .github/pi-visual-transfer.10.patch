diff --git a/src/components/pi-visual/PiVisual.css b/src/components/pi-visual/PiVisual.css
new file mode 100644
index 0000000..6e79444
--- /dev/null
+++ b/src/components/pi-visual/PiVisual.css
@@ -0,0 +1,43 @@
+.pi-visual-tools { flex: 0 0 auto; border-bottom: 1px solid var(--border); background: var(--bg-panel); color: var(--text); }
+.pi-visual-tools > summary { display: flex; align-items: center; gap: 8px; padding: 8px 12px; cursor: pointer; }
+.pi-visual-body { padding: 8px 12px; max-height: 32vh; overflow: auto; }
+.pi-visual-muted { color: var(--text-dim); font-size: 0.85rem; }
+.pi-worker-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 8px; margin-top: 10px; }
+.pi-worker { border: 1px solid var(--border); border-radius: 6px; padding: 10px; min-width: 0; }
+.pi-worker header { display: flex; flex-wrap: wrap; gap: 8px; }
+.pi-worker p { white-space: pre-wrap; overflow-wrap: anywhere; margin: 6px 0; }
+.pi-worker small { display: block; color: var(--text-dim); overflow-wrap: anywhere; }
+.pi-worker-state { margin-left: auto; color: var(--accent); }
+.pi-visual-scrim { z-index: 120; }
+.pi-visual-modal { width: min(1200px, 96vw); max-height: 94dvh; display: flex; flex-direction: column; gap: 10px; padding: 18px; overflow: auto; background: var(--bg-panel); color: var(--text); border: 1px solid var(--border-strong); border-radius: 10px; }
+.pi-visual-modal > header { display: flex; gap: 12px; align-items: center; min-width: 0; }
+.pi-visual-modal > header > span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pi-visual-modal > header > button { margin-left: auto; flex-shrink: 0; }
+.pi-visual-modal h2 { font-size: 1.1rem; margin: 0; }
+.pi-visual-modal p { margin: 0; }
+.pi-review-toolbar, .pi-desktop-form { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
+.pi-desktop-form label { display: flex; gap: 8px; align-items: center; font-size: 0.85rem; }
+.pi-desktop-form .input { max-width: 170px; }
+.pi-desktop-form .pi-fingerprint { flex: 1 1 100%; }
+.pi-desktop-form .pi-fingerprint input { flex: 1; max-width: none; }
+.pi-desktop-display { background: var(--bg); min-height: 200px; max-height: 65dvh; overflow: auto; }
+.pi-review { height: min(850px, 94dvh); }
+.pi-review-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(220px,28%); gap: 12px; flex: 1; min-height: 160px; overflow: hidden; }
+.pi-review-stage { overflow: auto; background: var(--bg); align-self: stretch; }
+.pi-review-image { position: relative; line-height: 0; }
+.pi-review-image img { width: 100%; height: auto; display: block; }
+.pi-review-image svg { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }
+.pi-review-image rect { fill: transparent; stroke: var(--accent); stroke-width: 2; }
+.pi-review-image circle { fill: var(--accent); }
+.pi-review-image text { fill: var(--bg); font-size: 22px; font-weight: 700; pointer-events: none; }
+.pi-review-image .is-resolved { opacity: 0.35; }
+.pi-review-comments { overflow: auto; display: flex; flex-direction: column; gap: 8px; }
+.pi-review-comments article { border: 1px solid var(--border); border-radius: 6px; padding: 10px; }
+.pi-review-comments article.is-selected { border-color: var(--accent); }
+.pi-review-comments label { display: block; margin-bottom: 8px; }
+.pi-review-comments textarea { display: block; width: 100%; min-height: 85px; resize: vertical; margin-top: 5px; }
+@media (max-width: 640px) {
+  .pi-visual-modal { padding: 10px; }
+  .pi-review-grid { grid-template-columns: minmax(0,1fr); grid-template-rows: minmax(160px,1fr) minmax(120px,35%); }
+  .pi-desktop-form label { flex-wrap: wrap; }
+}
diff --git a/src/components/pi-visual/PiVisualTools.tsx b/src/components/pi-visual/PiVisualTools.tsx
new file mode 100644
index 0000000..b1a0aca
--- /dev/null
+++ b/src/components/pi-visual/PiVisualTools.tsx
@@ -0,0 +1,50 @@
+import { useEffect, useRef, useState } from "react";
+import { Monitor, Users } from "lucide-react";
+import type { PiVisualWorkers, WorkerState } from "../../../shared/pi-visual.ts";
+import { useT } from "../../lib/i18n.ts";
+import { usePageVisible } from "../../lib/visibility.ts";
+import { visualRequest, visualUrl } from "../../lib/pi-visual/api.ts";
+import { DesktopViewer } from "./DesktopViewer.tsx";
+import "./PiVisual.css";
+
+export function PiVisualTools({paneId,machineId,enabled}: {paneId:string;machineId:string;enabled:boolean}) {
+  const t=useT(); const visible=usePageVisible(); const [open,setOpen]=useState(false);
+  const [snapshot,setSnapshot]=useState<PiVisualWorkers|null>(null); const [error,setError]=useState("");
+  const [desktop,setDesktop]=useState(false); const previousSession=useRef<string|null>(null);
+  useEffect(()=>{
+    if(!open||!visible||!enabled) {setDesktop(false);return;}
+    let alive=true; let timer: ReturnType<typeof setTimeout>; const abort=new AbortController();
+    const poll=async()=>{
+      try { const value=await visualRequest<PiVisualWorkers>(visualUrl(machineId,paneId,"workers"),"GET",undefined,AbortSignal.any([abort.signal,AbortSignal.timeout(15000)]));
+        if(alive) { if(previousSession.current && previousSession.current!==value.session) setDesktop(false); previousSession.current=value.session; setSnapshot(value); setError(""); }
+      } catch(err) { if(alive) {setError(err instanceof Error?err.message:"Pi unavailable");setSnapshot(null);setDesktop(false);} }
+      if(alive) timer=setTimeout(()=>void poll(),2000);
+    };
+    void poll();return ()=>{alive=false;abort.abort();clearTimeout(timer);};
+  },[open,visible,enabled,paneId,machineId]);
+  const state=(value:WorkerState):string=>({running:t("Running"),done:t("Completed"),failed:t("Failed"),cancelled:t("Cancelled"),interrupted:t("Interrupted"),queued:t("Queued"),unknown:t("Unknown")})[value];
+  return <details className="pi-visual-tools" open={open} onToggle={e=>setOpen(e.currentTarget.open)}>
+    <summary><Users size={16} aria-hidden="true"/>{t("Pi workers and desktop")}</summary>
+    {open && <div className="pi-visual-body">
+      <p className="pi-visual-muted">{t("Original Pi · recorded orche state; refreshes while open")}</p>
+      {error && <p role="alert">{error}</p>}
+      {!snapshot&&!error&&<p>{t("Loading…")}</p>}
+      {snapshot && <>
+        <button type="button" className="btn" disabled={!enabled||machineId!=="local"} onClick={()=>setDesktop(true)}><Monitor size={16} aria-hidden="true"/>{t("Open private desktop")}</button>
+        {machineId!=="local"&&<p>{t("For desktop viewing, open this app directly on the Pi host.")}</p>}
+        {!snapshot.workers.length&&<p>{t("No recorded orche jobs in this Pi branch.")}</p>}
+        <div className="pi-worker-list">{snapshot.workers.map(worker=><article className="pi-worker" key={worker.job}>
+          <header><strong>{worker.worker||worker.job}</strong><span>{worker.job} · {worker.role}</span><span className="pi-worker-state">{state(worker.state)}</span></header>
+          <p>{worker.request}</p>
+          <small>{[worker.model,worker.thinking,worker.lastTool].filter(Boolean).join(" · ")}</small>
+          <small>{worker.started ? new Date(worker.started).toLocaleTimeString():""}{worker.ended ? ` → ${new Date(worker.ended).toLocaleTimeString()}`:""}</small>
+          {worker.summary&&<details><summary>{t("Result")}</summary><p>{worker.summary}</p></details>}
+          {!!worker.children.length&&<details><summary>{t("Recorded sub-workers")}</summary>{worker.children.map(child=><p key={child.id}>{child.id} · {child.role} · {child.model}</p>)}</details>}
+        </article>)}</div>
+        {snapshot.truncated&&<p>{t("Recent jobs only; complete history remains in Pi records.")}</p>}
+        <p className="pi-visual-muted">{t("Use /orche commands for control; existing Pi approval rules are unchanged.")}</p>
+      </>}
+    </div>}
+    {desktop&&snapshot&&enabled&&<DesktopViewer key={snapshot.session} paneId={paneId} machineId={machineId} session={snapshot.session} onClose={()=>setDesktop(false)}/>}
+  </details>;
+}
